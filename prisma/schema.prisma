generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// 1. IDENTITY AND ACCESS
// ============================================================================

model User {
  id                  String                   @id @default(cuid())
  email               String                   @unique
  phone               String?                  @unique
  passwordHash        String
  status              String                   @default("ACTIVE") // ACTIVE, SUSPENDED, PENDING_VERIFICATION
  isStaff             Boolean                  @default(false)
  mfaEnabled          Boolean                  @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  profile             UserProfile?
  userRoles           UserRole[]
  sessions            Session[]
  auditLogs           AuditLog[]               @relation("ActorAuditLogs")
  consentRecords      ConsentRecord[]
  ticketOrders        TicketOrder[]
  ticketsOwned        Ticket[]                 @relation("TicketOwner")
  shopOrders          ShopOrder[]
  carts               Cart[]
  memberships         Membership[]
  loyaltyAccount      LoyaltyAccount?
  favouritePlayers    FavouritePlayer[]
  notificationPrefs   NotificationPreference[]
  notifications       Notification[]
  pollVotes           MatchPollVote[]
  donations           Donation[]
  gateRedemptions     TicketRedemption[]       @relation("GateStaffRedemptions")
  resultUpdates       Fixture[]                @relation("ResultUpdatedBy")
}

model UserProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  firstName           String
  lastName            String
  displayName         String?
  county              String?  @default("Embu")
  subCounty           String?
  ward                String?
  preferredLanguage   String   @default("en") // "en" | "sw"
  avatarUrl           String?
  supporterNumber     String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id                  String       @id @default(cuid())
  slug                String       @unique // SUPER_ADMIN, CLUB_EXECUTIVE, MEDIA_MANAGER, MATCHDAY_EDITOR, TICKETING_MANAGER, GATE_STAFF, STORE_MANAGER, MEMBERSHIP_MANAGER, SPONSOR_MANAGER, FINANCE_OFFICER, SUPPORTER
  name                String
  description         String
  isSystem            Boolean      @default(true)
  createdAt           DateTime     @default(now())

  permissions         Permission[]
  userRoles           UserRole[]
}

model Permission {
  id                  String   @id @default(cuid())
  roleId              String
  resource            String   // e.g. "articles", "fixtures", "match_centre", "tickets", "gate", "merchandise", "payments", "memberships", "loyalty", "sponsors", "donations", "reports", "users", "settings", "audit_logs"
  action              String   // e.g. "read", "create", "update", "delete", "publish", "export", "redeem", "reconcile"
  createdAt           DateTime @default(now())

  role                Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, resource, action])
}

model UserRole {
  id                  String   @id @default(cuid())
  userId              String
  roleId              String
  assignedBy          String?
  assignedAt          DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role                Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model Session {
  id                  String   @id @default(cuid())
  tokenHash           String   @unique
  userId              String
  scope               String   @default("PUBLIC") // "PUBLIC" | "ADMIN"
  ipAddress           String?
  userAgent           String?
  expiresAt           DateTime
  rotatedAt           DateTime @default(now())
  createdAt           DateTime @default(now())

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id                  String   @id @default(cuid())
  actorId             String?
  actorEmail          String?
  actorRole           String?
  action              String   // e.g. "FIXTURE_SCORE_UPDATED", "TICKET_REDEEMED", "PALETTE_CONFIRMED", "LOYALTY_ADJUSTED"
  targetType          String   // e.g. "Fixture", "Ticket", "Article", "ClubSettings"
  targetId            String
  beforeJson          String?
  afterJson           String?
  reason              String?
  ipAddress           String?
  createdAt           DateTime @default(now())

  actor               User?    @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([createdAt])
}

model ConsentRecord {
  id                  String   @id @default(cuid())
  userId              String?
  subjectEmail        String?
  consentType         String   // "PRIVACY_POLICY", "MARKETING_EMAIL", "MARKETING_SMS", "MARKETING_WHATSAPP", "DONOR_PUBLIC_RECOGNITION", "ANALYTICS_COOKIES"
  granted             Boolean
  policyVersion       String   @default("2026.1")
  ipAddress           String?
  recordedAt          DateTime @default(now())

  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

// ============================================================================
// 2. CLUB CONFIGURATION & FOOTBALL ENTITIES
// ============================================================================

model ClubSettings {
  id                          String   @id @default("default")
  clubName                    String   @default("3K FC")
  officialFullName            String   @default("3K Football Club — Embu")
  motto                       String   @default("God's Favourite Club • Home of Stars")
  location                    String   @default("Embu County, Kenya")
  foundingWard                String   @default("Nginda Ward (Kagumori, Kathangari, Kibugu, Kathuniri, Kiriari, Kairuri)")
  currentCompetition          String   @default("FKF Premier League")
  currentSeason               String   @default("2026/27")
  homeStadiumName             String   @default("Moi Stadium, Embu")
  homeStadiumConfirmed        Boolean  @default(false)
  homeStadiumVerificationNote String   @default("Subject to confirmation of the club's official match venue for FKF Premier League fixtures.")
  mainSponsorName             String   @default("Mozzart Bet Kenya")
  mainSponsorConfirmed        Boolean  @default(false)
  mainSponsorVerificationNote String   @default("Subject to confirmation of the current 2026/27 sponsorship agreement.")
  crestAssetUrl               String?
  crestConfirmed              Boolean  @default(false)
  paletteStatus               String   @default("PROVISIONAL") // "PROVISIONAL" | "CONFIRMED"
  primaryColor                String   @default("#B91C1C")
  primaryDarkColor            String   @default("#7F1D1D")
  secondaryColor              String   @default("#0F766E")
  accentColor                 String   @default("#F59E0B")
  surfaceLightColor           String   @default("#FFFFFF")
  surfaceOffwhiteColor        String   @default("#F8F7F4")
  surfaceDarkColor            String   @default("#0A0D12")
  contactEmail                String   @default("info@3kfc.co.ke")
  contactPhone                String   @default("+254 700 000 000")
  postalAddress               String   @default("Moi Stadium Complex, Embu Town, Embu County, Kenya")
  preparedBy                  String   @default("Caleb Ngiciri")
  updatedAt                   DateTime @updatedAt
}

model Club {
  id                  String   @id @default(cuid())
  name                String   @unique
  shortName           String
  slug                String   @unique
  crestUrl            String?
  primaryColor        String?
  city                String?
  stadiumName         String?
  isOurClub           Boolean  @default(false)
  createdAt           DateTime @default(now())

  teams               Team[]
  homeFixtures        Fixture[]        @relation("HomeClub")
  awayFixtures        Fixture[]        @relation("AwayClub")
  standings           LeagueStanding[]
}

model Season {
  id                  String   @id @default(cuid())
  name                String   @unique // e.g. "2026/27", "2025/26"
  startDate           DateTime
  endDate             DateTime
  isCurrent           Boolean  @default(false)
  createdAt           DateTime @default(now())

  fixtures            Fixture[]
  standings           LeagueStanding[]
  squadMemberships    SquadMembership[]
}

model Competition {
  id                  String   @id @default(cuid())
  name                String   @unique // e.g. "FKF Premier League", "FKF National Super League", "Mozzart Bet Cup", "FKF Division One Zone A"
  shortName           String
  slug                String   @unique
  tier                Int      @default(1)
  organizer           String   @default("Football Kenya Federation (FKF)")
  dataSourceType      String   @default("MANUAL") // "MANUAL" | "LICENSED_FEED"
  createdAt           DateTime @default(now())

  fixtures            Fixture[]
  standings           LeagueStanding[]
}

model Team {
  id                  String   @id @default(cuid())
  clubId              String
  name                String   // e.g. "3K FC First Team"
  category            String   @default("FIRST_TEAM") // "FIRST_TEAM", "YOUTH"
  createdAt           DateTime @default(now())

  club                Club              @relation(fields: [clubId], references: [id], onDelete: Cascade)
  squadMemberships    SquadMembership[]
  staffMembers        StaffMember[]
}

model Player {
  id                  String   @id @default(cuid())
  slug                String   @unique
  firstName           String
  lastName            String
  fullName            String
  nickname            String?
  shirtNumber         Int?
  position            String   // "GOALKEEPER", "DEFENDER", "MIDFIELDER", "FORWARD"
  specificRole        String?  // e.g. "Central Defender", "Striker"
  nationality         String   @default("Kenyan")
  biographyEn         String
  biographySw         String?
  photoUrl            String?
  photoVerified       Boolean  @default(false)
  previousClubs       String?  // JSON or comma-separated verified previous clubs
  isCaptain           Boolean  @default(false)
  isSpotlight         Boolean  @default(false)
  isActive            Boolean  @default(true)
  socialTwitter       String?
  socialInstagram     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  squadMemberships    SquadMembership[]
  matchEvents         MatchEvent[]
  lineupEntries       MatchLineupPlayer[]
  pollOptions         MatchPollOption[]
  favouritedBy        FavouritePlayer[]
}

model StaffMember {
  id                  String   @id @default(cuid())
  teamId              String?
  slug                String   @unique
  fullName            String
  roleTitleEn         String   // e.g. "Head Coach", "Club Patron", "Team Manager"
  roleTitleSw         String?
  category            String   @default("TECHNICAL_BENCH") // "TECHNICAL_BENCH", "LEADERSHIP", "MEDICAL"
  biographyEn         String
  biographySw         String?
  photoUrl            String?
  photoVerified       Boolean  @default(false)
  sortOrder           Int      @default(10)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  team                Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
}

model SquadMembership {
  id                  String   @id @default(cuid())
  playerId            String
  teamId              String
  seasonId            String
  shirtNumber         Int?
  appearances         Int      @default(0)
  starts              Int      @default(0)
  goals               Int      @default(0)
  assists             Int      @default(0)
  yellowCards         Int      @default(0)
  redCards            Int      @default(0)
  minutesPlayed       Int      @default(0)
  cleanSheets         Int      @default(0)
  statsVerified       Boolean  @default(true)
  statsSourceNote     String   @default("Official club match records")
  updatedAt           DateTime @updatedAt

  player              Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team                Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season              Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([playerId, teamId, seasonId])
}

model Fixture {
  id                  String   @id @default(cuid())
  slug                String   @unique
  competitionId       String
  seasonId            String
  homeClubId          String
  awayClubId          String
  matchday            Int?
  roundName           String?
  kickoffAt           DateTime
  kickoffConfirmed    Boolean  @default(true)
  timezone            String   @default("Africa/Nairobi")
  venueName           String   @default("Moi Stadium, Embu")
  venueCity           String   @default("Embu")
  venueConfirmed      Boolean  @default(false)
  isHomeMatch         Boolean  @default(true)
  status              String   @default("SCHEDULED") // "SCHEDULED", "POSTPONED", "DELAYED", "LIVE", "HALF_TIME", "FULL_TIME", "CANCELLED"
  liveMinute          Int?
  homeScore           Int?
  awayScore           Int?
  halfTimeHomeScore   Int?
  halfTimeAwayScore   Int?
  broadcastInfo       String?
  radioStreamUrl      String?
  highlightsVideoUrl  String?
  ticketsAvailable    Boolean  @default(false)
  attendance          Int?
  refereeName         String?
  resultUpdatedById   String?
  resultUpdatedAt     DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  competition         Competition       @relation(fields: [competitionId], references: [id])
  season              Season            @relation(fields: [seasonId], references: [id])
  homeClub            Club              @relation("HomeClub", fields: [homeClubId], references: [id])
  awayClub            Club              @relation("AwayClub", fields: [awayClubId], references: [id])
  resultUpdatedBy     User?             @relation("ResultUpdatedBy", fields: [resultUpdatedById], references: [id])

  events              MatchEvent[]
  lineups             MatchLineup[]
  statistics          MatchStatistic[]
  liveBlogUpdates     LiveBlogUpdate[]
  matchReport         MatchReport?
  poll                MatchPoll?
  ticketCategories    TicketCategory[]
  ticketOrders        TicketOrder[]
  tickets             Ticket[]

  @@index([kickoffAt])
  @@index([status])
}

model MatchEvent {
  id                  String   @id @default(cuid())
  fixtureId           String
  minute              Int
  addedTime           Int?
  type                String   // "KICK_OFF", "GOAL", "PENALTY_GOAL", "OWN_GOAL", "YELLOW_CARD", "RED_CARD", "SUBSTITUTION", "HALF_TIME", "FULL_TIME"
  clubSide            String   // "HOME" | "AWAY"
  playerId            String?
  playerName          String?
  secondaryPlayerName String?  // e.g. assist or substituted player
  descriptionEn       String
  descriptionSw       String?
  createdAt           DateTime @default(now())

  fixture             Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  player              Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([fixtureId, minute])
}

model LiveBlogUpdate {
  id                  String   @id @default(cuid())
  fixtureId           String
  minute              Int?
  eventType           String   @default("COMMENTARY") // "COMMENTARY", "GOAL", "CHANCE", "CARD", "SUB", "ANNOUNCEMENT"
  headlineEn          String?
  bodyEn              String
  bodySw              String?
  photoUrl            String?
  isPinned            Boolean  @default(false)
  status              String   @default("PUBLISHED") // "DRAFT", "PUBLISHED", "ARCHIVED"
  authorName          String   @default("3K FC Matchday Media")
  editHistoryJson     String?  // JSON array of previous revisions & timestamps
  publishedAt         DateTime @default(now())
  updatedAt           DateTime @updatedAt

  fixture             Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@index([fixtureId, publishedAt])
}

model MatchLineup {
  id                  String              @id @default(cuid())
  fixtureId           String
  clubSide            String              // "HOME" | "AWAY"
  formation           String              @default("4-3-3")
  headCoachName       String
  isConfirmed         Boolean             @default(false)
  confirmedAt         DateTime?
  createdAt           DateTime            @default(now())

  fixture             Fixture             @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  players             MatchLineupPlayer[]

  @@unique([fixtureId, clubSide])
}

model MatchLineupPlayer {
  id                  String      @id @default(cuid())
  lineupId            String
  playerId            String?
  playerName          String
  shirtNumber         Int
  position            String
  isStarter           Boolean     @default(true)
  captain             Boolean     @default(false)
  sortOrder           Int         @default(1)

  lineup              MatchLineup @relation(fields: [lineupId], references: [id], onDelete: Cascade)
  player              Player?     @relation(fields: [playerId], references: [id], onDelete: SetNull)
}

model MatchStatistic {
  id                  String   @id @default(cuid())
  fixtureId           String
  metricKey           String   // "POSSESSION", "SHOTS", "SHOTS_ON_TARGET", "CORNERS", "FOULS", "OFFSIDES", "YELLOW_CARDS", "RED_CARDS"
  labelEn             String
  labelSw             String
  homeValue           Int
  awayValue           Int
  unit                String?  // e.g. "%"
  isVerified          Boolean  @default(true)
  sourceNote          String   @default("Official Matchday Technical Record")

  fixture             Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)

  @@unique([fixtureId, metricKey])
}

model LeagueStanding {
  id                  String      @id @default(cuid())
  competitionId       String
  seasonId            String
  clubId              String
  position            Int
  played              Int         @default(0)
  won                 Int         @default(0)
  drawn               Int         @default(0)
  lost                Int         @default(0)
  goalsFor            Int         @default(0)
  goalsAgainst        Int         @default(0)
  goalDifference      Int         @default(0)
  points              Int         @default(0)
  form                String?     // e.g. "W,W,D,W,W"
  qualificationNote   String?     // e.g. "Promoted to FKF Premier League"
  dataSource          String      @default("MANUAL_VERIFIED") // "MANUAL_VERIFIED" | "FKF_OFFICIAL"
  isAvailable         Boolean     @default(true)
  lastUpdatedAt       DateTime    @default(now())

  competition         Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  season              Season      @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  club                Club        @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([competitionId, seasonId, clubId])
  @@index([competitionId, seasonId, position])
}

model MatchReport {
  id                  String   @id @default(cuid())
  fixtureId           String   @unique
  articleId           String?  @unique
  headlineEn          String
  headlineSw          String?
  summaryEn           String
  summarySw           String?
  bodyEn              String
  bodySw              String?
  authorName          String   @default("3K FC Editorial Desk")
  publishedAt         DateTime @default(now())

  fixture             Fixture  @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  article             Article? @relation(fields: [articleId], references: [id], onDelete: SetNull)
}

model MatchPoll {
  id                  String            @id @default(cuid())
  fixtureId           String            @unique
  titleEn             String            @default("Fan Man of the Match Poll")
  titleSw             String            @default("Kura ya Mashabiki: Mchezaji Bora wa Mechi")
  disclaimerEn        String            @default("Official 3K FC Supporters Poll — not an official FKF competition award.")
  status              String            @default("OPEN") // "DRAFT", "OPEN", "CLOSED"
  opensAt             DateTime          @default(now())
  closesAt            DateTime?
  createdAt           DateTime          @default(now())

  fixture             Fixture           @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  options             MatchPollOption[]
  votes               MatchPollVote[]
}

model MatchPollOption {
  id                  String          @id @default(cuid())
  pollId              String
  playerId            String?
  playerName          String
  shirtNumber         Int?
  position            String?
  voteCount           Int             @default(0)

  poll                MatchPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  player              Player?         @relation(fields: [playerId], references: [id], onDelete: SetNull)
  votes               MatchPollVote[]
}

model MatchPollVote {
  id                  String          @id @default(cuid())
  pollId              String
  optionId            String
  userId              String
  ipHash              String?
  createdAt           DateTime        @default(now())

  poll                MatchPoll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option              MatchPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
}

// ============================================================================
// 3. EDITORIAL, MEDIA & BILINGUAL CONTENT
// ============================================================================

model Category {
  id                  String    @id @default(cuid())
  slug                String    @unique
  nameEn              String
  nameSw              String
  descriptionEn       String?
  sortOrder           Int       @default(1)

  articles            Article[]
}

model Tag {
  id                  String       @id @default(cuid())
  slug                String       @unique
  nameEn              String
  nameSw              String

  articles            ArticleTag[]
}

model Article {
  id                  String               @id @default(cuid())
  slug                String               @unique
  categoryId          String
  authorName          String               @default("3K FC Media")
  featuredImageUrl    String?
  featuredImageAlt    String               @default("3K FC Official Editorial")
  isPlaceholderImage  Boolean              @default(true)
  galleryJson         String?
  videoEmbedUrl       String?
  status              String               @default("PUBLISHED") // "DRAFT", "SCHEDULED", "PUBLISHED", "ARCHIVED"
  isFeatured          Boolean              @default(false)
  heroOrder           Int                  @default(99)
  viewCount           Int                  @default(0)
  scheduledFor        DateTime?
  publishedAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  category            Category             @relation(fields: [categoryId], references: [id])
  translations        ArticleTranslation[]
  tags                ArticleTag[]
  matchReport         MatchReport?

  @@index([status, publishedAt])
  @@index([isFeatured, heroOrder])
}

model ArticleTranslation {
  id                  String   @id @default(cuid())
  articleId           String
  locale              String   // "en" | "sw"
  headline            String
  summary             String
  body                String
  seoTitle            String?
  seoDescription      String?
  isComplete          Boolean  @default(true)
  updatedAt           DateTime @updatedAt

  article             Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
}

model ArticleTag {
  articleId           String
  tagId               String

  article             Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag                 Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
}

model MediaAsset {
  id                  String   @id @default(cuid())
  fileName            String
  mimeType            String
  sizeBytes           Int
  url                 String
  altTextEn           String
  altTextSw           String?
  isAuthenticVerified Boolean  @default(false)
  placeholderLabel    String?
  uploadedBy          String?
  createdAt           DateTime @default(now())
}

model Video {
  id                  String   @id @default(cuid())
  slug                String   @unique
  titleEn             String
  titleSw             String?
  descriptionEn       String
  descriptionSw       String?
  category            String   // "HIGHLIGHTS", "GOALS", "INTERVIEWS", "TRAINING", "BEHIND_THE_SCENES", "DOCUMENTARY"
  youtubeVideoId      String
  sourceUrl           String
  thumbnailUrl        String?
  durationLabel       String   @default("04:15")
  hasCaptions         Boolean  @default(true)
  isFeatured          Boolean  @default(false)
  membersOnly         Boolean  @default(false)
  status              String   @default("PUBLISHED")
  viewCount           Int      @default(0)
  publishedAt         DateTime @default(now())
}

model StaticPage {
  id                  String            @id @default(cuid())
  slug                String            @unique
  status              String            @default("PUBLISHED")
  updatedAt           DateTime          @updatedAt

  translations        PageTranslation[]
}

model PageTranslation {
  id                  String     @id @default(cuid())
  pageId              String
  locale              String     // "en" | "sw"
  title               String
  summary             String?
  body                String
  seoTitle            String?
  seoDescription      String?
  isComplete          Boolean    @default(true)
  updatedAt           DateTime   @updatedAt

  page                StaticPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
}

model HistoryMilestone {
  id                  String   @id @default(cuid())
  eraOrSeason         String   // e.g. "Founding Era — Nginda Ward", "FKF Division One Zone A", "2025/26 NSL Campaign", "2026/27 FKF Premier League"
  titleEn             String
  titleSw             String
  descriptionEn       String
  descriptionSw       String
  isVerified          Boolean  @default(true)
  verificationSource  String
  imageUrl            String?
  articleSlug         String?
  sortOrder           Int      @default(1)
}

// ============================================================================
// 4. OFFICIAL TICKETING SYSTEM & GATE SCANNING
// ============================================================================

model TicketCategory {
  id                  String            @id @default(cuid())
  fixtureId           String
  nameEn              String            // e.g. "General Admission (Terraces)", "Main Stand Covered", "VIP Hospitality", "Accessible Seating"
  nameSw              String
  descriptionEn       String?
  priceKesCents       Int               // Integer minor units: e.g. KES 200 = 20000 cents
  maxPerOrder         Int               @default(5)
  requiresMembership  Boolean           @default(false)
  isAccessibleSeating Boolean           @default(false)
  saleOpensAt         DateTime          @default(now())
  saleClosesAt        DateTime?
  isActive            Boolean           @default(true)

  fixture             Fixture           @relation(fields: [fixtureId], references: [id], onDelete: Cascade)
  inventory           TicketInventory?
  orderItems          TicketOrderItem[]
  tickets             Ticket[]
}

model TicketInventory {
  id                  String         @id @default(cuid())
  categoryId          String         @unique
  totalCapacity       Int
  reservedCount       Int            @default(0)
  soldCount           Int            @default(0)
  updatedAt           DateTime       @updatedAt

  category            TicketCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model TicketOrder {
  id                  String            @id @default(cuid())
  orderNumber         String            @unique
  fixtureId           String
  userId              String?
  buyerName           String
  buyerEmail          String
  buyerPhone          String
  totalKesCents       Int
  status              String            @default("PENDING_PAYMENT") // "PENDING_PAYMENT", "PAID", "EXPIRED", "CANCELLED", "REFUNDED"
  expiresAt           DateTime
  paidAt              DateTime?
  paymentTxId         String?           @unique
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  fixture             Fixture           @relation(fields: [fixtureId], references: [id])
  user                User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  paymentTx           PaymentTransaction? @relation(fields: [paymentTxId], references: [id])
  items               TicketOrderItem[]
  tickets             Ticket[]
  refunds             TicketRefund[]

  @@index([status, expiresAt])
}

model TicketOrderItem {
  id                  String         @id @default(cuid())
  orderId             String
  categoryId          String
  quantity            Int
  unitPriceKesCents   Int
  subtotalKesCents    Int

  order               TicketOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  category            TicketCategory @relation(fields: [categoryId], references: [id])
}

model Ticket {
  id                  String             @id @default(cuid())
  ticketCode          String             @unique // Unpredictable public reference e.g. "3K-TKT-9F8A2C1D"
  signedToken         String             @unique // HMAC-SHA256 signed payload (no PII inside QR)
  orderId             String
  fixtureId           String
  categoryId          String
  ownerUserId         String?
  holderName          String
  status              String             @default("VALID") // "VALID", "REDEEMED", "TRANSFERRED_INVALIDATED", "CANCELLED", "REFUNDED"
  issuedAt            DateTime           @default(now())
  redeemedAt          DateTime?
  redeemedGate        String?
  redeemedByStaffId   String?

  order               TicketOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fixture             Fixture            @relation(fields: [fixtureId], references: [id])
  category            TicketCategory     @relation(fields: [categoryId], references: [id])
  owner               User?              @relation("TicketOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  transfers           TicketTransfer[]
  redemptions         TicketRedemption[]
  refunds             TicketRefund[]

  @@index([fixtureId, status])
}

model TicketTransfer {
  id                  String   @id @default(cuid())
  ticketId            String
  fromName            String
  fromEmail           String
  toName              String
  toEmail             String
  toPhone             String?
  previousTicketCode  String
  newTicketCode       String
  transferredAt       DateTime @default(now())

  ticket              Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model TicketRedemption {
  id                  String   @id @default(cuid())
  ticketId            String
  fixtureId           String
  gateName            String   @default("Main Gate A — Moi Stadium")
  staffUserId         String?
  staffName           String
  scanOutcome         String   // "VALID_ACCEPTED", "ALREADY_USED", "INVALID_TOKEN", "WRONG_MATCH", "CANCELLED_OR_REFUNDED", "UNPAID"
  wasOfflineSync      Boolean  @default(false)
  scannedAt           DateTime @default(now())

  ticket              Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  staffUser           User?    @relation("GateStaffRedemptions", fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, scanOutcome])
}

model TicketRefund {
  id                  String             @id @default(cuid())
  orderId             String
  ticketId            String?
  amountKesCents      Int
  reason              String
  status              String             @default("REQUESTED") // "REQUESTED", "APPROVED", "PROCESSED", "REJECTED"
  approvedBy          String?
  refundTxId          String?
  createdAt           DateTime           @default(now())
  processedAt         DateTime?

  order               TicketOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticket              Ticket?            @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  refundTx            RefundTransaction? @relation(fields: [refundTxId], references: [id])
}

// ============================================================================
// 5. OFFICIAL ONLINE STORE & INVENTORY
// ============================================================================

model Product {
  id                  String           @id @default(cuid())
  slug                String           @unique
  sku                 String           @unique
  nameEn              String
  nameSw              String
  descriptionEn       String
  descriptionSw       String
  category            String           // "JERSEYS", "TRAINING_WEAR", "SCARVES", "CAPS", "APPAREL", "ACCESSORIES", "SPECIAL_EDITION"
  priceKesCents       Int              // Integer minor units
  isAuthenticClubGear Boolean          @default(true)
  isFeatured          Boolean          @default(false)
  isAvailable         Boolean          @default(true)
  weightGrams         Int              @default(250)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  variants            ProductVariant[]
  images              ProductImage[]
  orderItems          ShopOrderItem[]
  cartItems           CartItem[]
}

model ProductVariant {
  id                  String              @id @default(cuid())
  productId           String
  sku                 String              @unique
  size                String              // "S", "M", "L", "XL", "XXL", "ONE_SIZE"
  color               String              @default("Home Crimson/Gold")
  stockQuantity       Int                 @default(0)
  reservedQuantity    Int                 @default(0)
  priceAdjustmentCents Int                @default(0)

  product             Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements           InventoryMovement[]
  orderItems          ShopOrderItem[]
  cartItems           CartItem[]
}

model ProductImage {
  id                  String   @id @default(cuid())
  productId           String
  url                 String
  altTextEn           String
  isPrimary           Boolean  @default(false)
  sortOrder           Int      @default(1)

  product             Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id                  String         @id @default(cuid())
  variantId           String
  delta               Int            // +50 restock, -1 sale, +1 refund return
  reason              String         // "INITIAL_STOCK", "ORDER_RESERVATION", "ORDER_PAID", "MANUAL_ADJUSTMENT", "REFUND_RETURN"
  referenceId         String?
  recordedBy          String?
  createdAt           DateTime       @default(now())

  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model Cart {
  id                  String     @id @default(cuid())
  sessionToken        String     @unique
  userId              String?
  updatedAt           DateTime   @updatedAt

  user                User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               CartItem[]
}

model CartItem {
  id                  String         @id @default(cuid())
  cartId              String
  productId           String
  variantId           String
  quantity            Int            @default(1)
  customizationName   String?
  customizationNumber Int?

  cart                Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product             Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant             ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model DeliveryOption {
  id                  String      @id @default(cuid())
  code                String      @unique // "EMBU_COLLECTION", "EMBU_COUNTY_COURIER", "UPCOUNTRY_KENYA_COURIER"
  nameEn              String
  nameSw              String
  feeKesCents         Int         // 0 for Embu stadium/club shop collection
  estimatedDays       String      @default("1-2 business days")
  isActive            Boolean     @default(true)

  orders              ShopOrder[]
}

model ShopOrder {
  id                  String             @id @default(cuid())
  orderNumber         String             @unique
  userId              String?
  customerName        String
  customerEmail       String
  customerPhone       String
  deliveryOptionId    String
  shippingAddress     String?
  county              String             @default("Embu")
  subtotalKesCents    Int
  discountKesCents    Int                @default(0)
  deliveryFeeKesCents Int
  totalKesCents       Int
  status              String             @default("PENDING_PAYMENT") // "PENDING_PAYMENT", "PAID", "PROCESSING", "READY_FOR_COLLECTION", "DISPATCHED", "DELIVERED", "CANCELLED", "REFUNDED"
  paymentTxId         String?            @unique
  utmSource           String?
  utmCampaign         String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  user                User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  deliveryOption      DeliveryOption     @relation(fields: [deliveryOptionId], references: [id])
  paymentTx           PaymentTransaction? @relation(fields: [paymentTxId], references: [id])
  items               ShopOrderItem[]
  fulfilment          FulfilmentRecord?
}

model ShopOrderItem {
  id                  String         @id @default(cuid())
  orderId             String
  productId           String
  variantId           String
  productName         String
  variantLabel        String
  quantity            Int
  unitPriceKesCents   Int
  subtotalKesCents    Int

  order               ShopOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product        @relation(fields: [productId], references: [id])
  variant             ProductVariant @relation(fields: [variantId], references: [id])
}

model FulfilmentRecord {
  id                  String    @id @default(cuid())
  orderId             String    @unique
  status              String    @default("PENDING") // "PENDING", "PACKED", "READY_AT_EMBU_HUB", "DISPATCHED", "COLLECTED", "DELIVERED"
  trackingReference   String?
  collectionPoint     String    @default("3K FC Official Club Desk — Embu Town")
  handledByStaff      String?
  notes               String?
  dispatchedAt        DateTime?
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt

  order               ShopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ============================================================================
// 6. PAYMENTS (M-PESA DARAJA & PROVIDER ADAPTER)
// ============================================================================

model PaymentTransaction {
  id                      String                  @id @default(cuid())
  reference               String                  @unique // e.g. "3K-PAY-20261023-A9F2"
  provider                String                  @default("MPESA_DARAJA") // "MPESA_DARAJA", "INTERNATIONAL_CARD_ADAPTER"
  environment             String                  @default("sandbox") // "sandbox" | "production"
  purpose                 String                  // "TICKET_ORDER", "SHOP_ORDER", "MEMBERSHIP", "DONATION"
  purposeTargetId         String
  phoneNormalized         String
  amountKesCents          Int
  providerFeeKesCents     Int                     @default(0)
  netProceedsKesCents     Int                     @default(0)
  merchantRequestId       String?                 @unique
  checkoutRequestId       String?                 @unique
  mpesaReceiptNumber      String?                 @unique
  status                  String                  @default("PENDING") // "PENDING", "SUCCESS", "FAILED", "CANCELLED", "EXPIRED"
  resultCode              Int?
  resultDescription       String?
  confirmedAt             DateTime?
  expiresAt               DateTime
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  callbacks               PaymentCallback[]
  reconciliations         PaymentReconciliation[]
  refunds                 RefundTransaction[]
  ticketOrder             TicketOrder?
  shopOrder               ShopOrder?
  membership              Membership?
  donation                Donation?

  @@index([status, createdAt])
  @@index([purpose, purposeTargetId])
}

model PaymentCallback {
  id                      String              @id @default(cuid())
  transactionId           String?
  checkoutRequestId       String
  idempotencyKey          String              @unique
  resultCode              Int
  resultDesc              String
  mpesaReceiptNumber      String?
  sanitizedPayloadJson    String              // Sensitive phone digits masked
  processedStatus         String              @default("PROCESSED") // "PROCESSED", "DUPLICATE_IGNORED", "UNMATCHED"
  receivedAt              DateTime            @default(now())

  transaction             PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
}

model PaymentReconciliation {
  id                      String             @id @default(cuid())
  transactionId           String
  verifiedBy              String             // "DARAJA_CALLBACK", "DARAJA_STK_QUERY", "FINANCE_OFFICER_AUDIT"
  previousStatus          String
  verifiedStatus          String
  notes                   String?
  reconciledAt            DateTime           @default(now())

  transaction             PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model RefundTransaction {
  id                      String             @id @default(cuid())
  originalTxId            String
  reference               String             @unique
  amountKesCents          Int
  reason                  String
  status                  String             @default("PENDING_VERIFICATION") // "PENDING_VERIFICATION", "VERIFIED_COMPLETED", "FAILED"
  processedBy             String?
  verifiedAt              DateTime?
  createdAt               DateTime           @default(now())

  originalTx              PaymentTransaction @relation(fields: [originalTxId], references: [id])
  ticketRefunds           TicketRefund[]
}

// ============================================================================
// 7. SUPPORTERS' CLUB, MEMBERSHIP & LOYALTY PROGRAMME
// ============================================================================

model MembershipPlan {
  id                      String       @id @default(cuid())
  slug                    String       @unique
  nameEn                  String       // e.g. "Nginda Roots Monthly Member", "Embu Gold Seasonal Member", "Diaspora Star Supporter"
  nameSw                  String
  billingCycle            String       // "MONTHLY" | "SEASONAL"
  durationDays            Int          @default(365)
  priceKesCents           Int
  merchDiscountPercent    Int          @default(10)
  ticketPresaleAccess     Boolean      @default(true)
  welcomeLoyaltyPoints    Int          @default(100)
  benefitsJsonEn          String       // Approved benefits JSON array
  benefitsJsonSw          String
  isActive                Boolean      @default(true)
  sortOrder               Int          @default(1)

  memberships             Membership[]
}

model Membership {
  id                      String                 @id @default(cuid())
  userId                  String
  planId                  String
  membershipNumber        String                 @unique // e.g. "3K-MEM-2026-0001"
  status                  String                 @default("PENDING_PAYMENT") // "PENDING_PAYMENT", "ACTIVE", "EXPIRED", "CANCELLED"
  startsAt                DateTime?
  expiresAt               DateTime?
  paymentTxId             String?                @unique
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                    MembershipPlan         @relation(fields: [planId], references: [id])
  paymentTx               PaymentTransaction?    @relation(fields: [paymentTxId], references: [id])
  card                    DigitalMembershipCard?
  renewals                MembershipRenewal[]
}

model MembershipRenewal {
  id                      String     @id @default(cuid())
  membershipId            String
  previousExpiresAt       DateTime
  newExpiresAt            DateTime
  paymentReference        String
  renewedAt               DateTime   @default(now())

  membership              Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model DigitalMembershipCard {
  id                      String     @id @default(cuid())
  membershipId            String     @unique
  cardIdentifier          String     @unique
  verificationToken       String     @unique
  tierLabel               String
  holderDisplayName       String
  validityStatus          String     @default("VALID") // "VALID", "EXPIRED", "SUSPENDED"
  issuedAt                DateTime   @default(now())

  membership              Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
}

model LoyaltyAccount {
  id                      String               @id @default(cuid())
  userId                  String               @unique
  balancePoints           Int                  @default(0)
  lifetimePointsEarned    Int                  @default(0)
  updatedAt               DateTime             @updatedAt

  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerEntries           LoyaltyLedgerEntry[]
  redemptions             RewardRedemption[]
}

model LoyaltyLedgerEntry {
  id                      String         @id @default(cuid())
  accountId               String
  idempotencyKey          String         @unique // Prevents duplicate point awards for the same event
  eventType               String         // "MATCH_ATTENDANCE_VERIFIED", "SHOP_ORDER_COMPLETED", "MEMBERSHIP_ACTIVATED", "REWARD_REDEEMED", "REFUND_REVERSAL", "ADMIN_MANUAL_ADJUSTMENT"
  pointsDelta             Int            // Positive for earn, negative for redemption/reversal
  balanceAfter            Int
  reason                  String
  sourceReferenceId       String?
  authorizedByUserId      String?
  createdAt               DateTime       @default(now())

  account                 LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
}

model LoyaltyReward {
  id                      String             @id @default(cuid())
  code                    String             @unique
  titleEn                 String
  titleSw                 String
  descriptionEn           String
  pointsCost              Int
  rewardType              String             // "MERCH_DISCOUNT_VOUCHER", "TICKET_OFFER", "SUPPORTER_EVENT_PASS"
  discountKesCents        Int                @default(0)
  isActive                Boolean            @default(true)

  redemptions             RewardRedemption[]
}

model RewardRedemption {
  id                      String         @id @default(cuid())
  accountId               String
  rewardId                String
  voucherCode             String         @unique
  pointsSpent             Int
  status                  String         @default("ISSUED") // "ISSUED", "USED", "REVERSED"
  redeemedAt              DateTime       @default(now())

  account                 LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reward                  LoyaltyReward  @relation(fields: [rewardId], references: [id])
}

// ============================================================================
// 8. SPONSORS, DONATIONS, NOTIFICATIONS & FAN ENGAGEMENT
// ============================================================================

model Sponsor {
  id                      String             @id @default(cuid())
  slug                    String             @unique
  businessName            String
  category                String             // "MAIN_PARTNER", "KIT_PARTNER", "OFFICIAL_SUPPLIER", "DIGITAL_PARTNER", "COMMUNITY_PARTNER"
  descriptionEn           String
  descriptionSw           String?
  logoUrl                 String?
  websiteUrl              String
  contractStatus          String             @default("SUBJECT_TO_CONFIRMATION") // "ACTIVE_VERIFIED", "SUBJECT_TO_CONFIRMATION", "EXPIRED"
  verificationNote        String?
  startDate               DateTime?
  endDate                 DateTime?
  displayPriority         Int                @default(1)
  isPublished             Boolean            @default(true)
  createdAt               DateTime           @default(now())

  placements              SponsorPlacement[]
  campaigns               SponsorCampaign[]
}

model SponsorPlacement {
  id                      String   @id @default(cuid())
  sponsorId               String
  placementZone           String   // "HOMEPAGE_MAIN", "MATCH_CENTRE_BANNER", "NEWS_ARTICLE_FOOTER", "TICKETS_PAGE", "SHOP_BANNER"
  labelEn                 String   @default("Official Partner")
  targetUrl               String
  utmSource               String   @default("3kfc_website")
  utmMedium               String   @default("sponsor_placement")
  utmCampaign             String
  isActive                Boolean  @default(true)

  sponsor                 Sponsor  @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  events                  SponsorEvent[]
}

model SponsorCampaign {
  id                      String         @id @default(cuid())
  sponsorId               String
  name                    String
  utmCampaign             String         @unique
  startDate               DateTime
  endDate                 DateTime
  status                  String         @default("ACTIVE")

  sponsor                 Sponsor        @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  events                  SponsorEvent[]
}

model SponsorEvent {
  id                      String            @id @default(cuid())
  placementId             String?
  campaignId              String?
  eventType               String            // "MEASURED_IMPRESSION", "CLICK", "REFERRAL_VISIT", "ATTRIBUTED_CONVERSION"
  pagePath                String
  consentVerified         Boolean           @default(true)
  conversionOrderRef      String?
  conversionValueKesCents Int               @default(0)
  recordedAt              DateTime          @default(now())

  placement               SponsorPlacement? @relation(fields: [placementId], references: [id], onDelete: SetNull)
  campaign                SponsorCampaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([eventType, recordedAt])
}

model SponsorEnquiry {
  id                      String   @id @default(cuid())
  organisation            String
  contactPerson           String
  businessEmail           String
  phone                   String
  partnershipInterest     String   // "MAIN_PARTNERSHIP", "KIT_BRANDING", "MATCHDAY_SPONSORSHIP", "DIGITAL_MEDIA", "COMMUNITY_YOUTH"
  budgetRange             String?
  message                 String
  consentGranted          Boolean  @default(true)
  status                  String   @default("NEW") // "NEW", "IN_REVIEW", "CONTACTED", "ARCHIVED"
  createdAt               DateTime @default(now())
}

model DonationCampaign {
  id                      String     @id @default(cuid())
  slug                    String     @unique
  titleEn                 String
  titleSw                 String
  purposeEn               String
  purposeSw               String
  disclaimerEn            String     @default("Verified supporter contributions directly support 3K FC club operations and community football initiatives in Embu County.")
  targetKesCents          Int?       // Optional verified target
  confirmedTotalKesCents  Int        @default(0) // Strictly computed from CONFIRMED donations minus refunds
  confirmedDonorCount     Int        @default(0)
  isActive                Boolean    @default(true)
  createdAt               DateTime   @default(now())

  donations               Donation[]
}

model Donation {
  id                      String              @id @default(cuid())
  campaignId              String
  userId                  String?
  donorName               String
  donorEmail              String?
  donorPhone              String?
  country                 String              @default("Kenya")
  amountKesCents          Int
  paymentMethod           String              @default("MPESA_DARAJA") // "MPESA_DARAJA", "INTERNATIONAL_ADAPTER"
  status                  String              @default("PENDING") // "PENDING", "CONFIRMED", "FAILED", "REFUNDED"
  isAnonymous             Boolean             @default(false)
  publicRecognitionConsent Boolean            @default(false)
  supporterMessage        String?
  paymentTxId             String?             @unique
  confirmedAt             DateTime?
  createdAt               DateTime            @default(now())

  campaign                DonationCampaign    @relation(fields: [campaignId], references: [id])
  user                    User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  paymentTx               PaymentTransaction? @relation(fields: [paymentTxId], references: [id])
  receipt                 DonationReceipt?

  @@index([campaignId, status])
}

model DonationReceipt {
  id                      String   @id @default(cuid())
  donationId              String   @unique
  receiptNumber           String   @unique // e.g. "3K-DON-2026-0001"
  issuedToName            String
  amountKesCents          Int
  paymentReference        String
  issuedAt                DateTime @default(now())

  donation                Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)
}

model Notification {
  id                      String                 @id @default(cuid())
  userId                  String?
  category                String                 // "FIXTURE_REMINDER", "KICKOFF_ALERT", "GOAL_RESULT", "TICKET_CONFIRMATION", "MEMBERSHIP_RENEWAL", "ORDER_STATUS", "CLUB_ANNOUNCEMENT"
  titleEn                 String
  titleSw                 String?
  bodyEn                  String
  bodySw                  String?
  actionUrl               String?
  isRead                  Boolean                @default(false)
  createdAt               DateTime               @default(now())

  user                    User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries              NotificationDelivery[]
}

model NotificationPreference {
  id                      String   @id @default(cuid())
  userId                  String
  channel                 String   // "WEB_PUSH", "EMAIL", "SMS", "WHATSAPP"
  category                String   // "MATCH_UPDATES", "TICKETS_AND_ORDERS", "MEMBERSHIP", "CLUB_NEWS"
  enabled                 Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel, category])
}

model NotificationDelivery {
  id                      String       @id @default(cuid())
  notificationId          String
  channel                 String       // "WEB_PUSH", "EMAIL", "SMS", "WHATSAPP"
  recipientAddress        String
  status                  String       @default("QUEUED") // "QUEUED", "SENT_TO_PROVIDER", "DELIVERED_CONFIRMED", "FAILED", "PROVIDER_UNCONFIGURED"
  retryCount              Int          @default(0)
  providerMessageId       String?
  failureReason           String?
  queuedAt                DateTime     @default(now())
  deliveredAt             DateTime?

  notification            Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
}

model FavouritePlayer {
  id                      String   @id @default(cuid())
  userId                  String
  playerId                String
  createdAt               DateTime @default(now())

  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  player                  Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([userId, playerId])
}

model NewsletterSubscription {
  id                      String    @id @default(cuid())
  email                   String    @unique
  preferredLanguage       String    @default("en")
  status                  String    @default("SUBSCRIBED") // "SUBSCRIBED", "UNSUBSCRIBED"
  consentRecordedAt       DateTime  @default(now())
  unsubscribedAt          DateTime?
}

model TranslationKey {
  id                      String   @id @default(cuid())
  namespace               String   @default("common")
  key                     String   @unique
