# ==============================================================================
# 3K FC OFFICIAL WEBSITE & DIGITAL FAN PLATFORM — ENVIRONMENT CONFIGURATION
# Club: 3K FC, Embu County, Kenya | Competition: FKF Premier League (2026/27)
# Prepared by: Caleb Ngiciri
# Never commit real production secrets to version control.
# ==============================================================================

# 1. Database Connection
# Local SQLite (default development & test runner):
DATABASE_URL="file:./dev.db"
# Production Managed PostgreSQL (uncomment when using prisma/schema.postgresql.prisma):
# DATABASE_URL="postgresql://db_user:db_password@db-host.region.rds.amazonaws.com:5432/3kfc_prod?schema=public&sslmode=require"
# DIRECT_URL="postgresql://db_user:db_password@db-host.region.rds.amazonaws.com:5432/3kfc_prod?schema=public&sslmode=require"

# 2. Application & Authentication Security
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_SESSION_SECRET="replace-with-64-char-cryptographic-random-hex-secret-in-production"
QR_TICKET_SIGNING_SECRET="replace-with-64-char-hmac-sha256-ticket-signing-secret-in-production"
ADMIN_BOOTSTRAP_TOKEN="replace-with-one-time-setup-token-for-first-superadmin-provisioning"

# 3. Safaricom M-Pesa Daraja Integration
# Environment: "sandbox" | "production"
MPESA_ENVIRONMENT="sandbox"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE="174379"
MPESA_PASSKEY=""
MPESA_CALLBACK_URL="https://3kfc.co.ke/api/payments/mpesa/callback"
MPESA_CALLBACK_SECRET="replace-with-webhook-verification-token"

# 4. Durable Object / Media Storage (S3 / Cloudflare R2 / Cloudinary compatible)
MEDIA_STORAGE_PROVIDER="s3-compatible"
MEDIA_STORAGE_BUCKET="3kfc-official-media"
MEDIA_STORAGE_REGION="af-south-1"
MEDIA_STORAGE_ENDPOINT=""
MEDIA_STORAGE_ACCESS_KEY_ID=""
MEDIA_STORAGE_SECRET_ACCESS_KEY=""
NEXT_PUBLIC_MEDIA_CDN_URL=""

# 5. Transactional Email Provider (Resend / Postmark / SMTP)
EMAIL_PROVIDER="resend"
EMAIL_API_KEY=""
EMAIL_FROM_ADDRESS="official@3kfc.co.ke"

# 6. SMS Provider (Africa's Talking / Advanta SMS Kenya)
SMS_PROVIDER="africastalking"
SMS_API_KEY=""
SMS_USERNAME=""
SMS_SENDER_ID="3KFC_EMBU"

# 7. WhatsApp Business Cloud API Provider
WHATSAPP_PROVIDER="meta-cloud-api"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# 8. Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:media@3kfc.co.ke"

# 9. Privacy-Conscious Analytics & Real-Time Infrastructure
NEXT_PUBLIC_ANALYTICS_ENABLED="true"
REALTIME_TRANSPORT="sse"

# 10. Optional Licensed Football Competition Data Provider
FOOTBALL_DATA_PROVIDER="manual"
FOOTBALL_DATA_API_KEY=""
